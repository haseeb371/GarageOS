# AutoGaragify environment variables
#
# Local: copy to .env.local
# Production (Vercel → Settings → Environment Variables):
#   APP_URL=https://autogaragify.com
#   DATABASE_URL=...
#   GARAGEOS_SECRET_KEY=...
#   RESEND_API_KEY / EMAIL_FROM (platform auth email)
# Shop Ops can also store Resend/Twilio/Zapier per shop in Postgres (no redeploy).
#
# REQUIRED (core app):
# DATABASE_URL          PostgreSQL connection string
# GARAGEOS_SECRET_KEY   32-byte base64 key that encrypts shop-pasted provider secrets
#                       (Resend/Twilio/Zapier) at rest. Generate with:
#                       node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#                       If unset, secrets are stored plaintext (dev only). Never rotate
#                       after production use without re-saving each shop's credentials.
# ENCRYPTION_KEY        Optional alias for GARAGEOS_SECRET_KEY (team/shared naming).
#
# OPTIONAL (inspection photo/video uploads only):
# CLOUDINARY_URL        cloudinary://API_KEY:API_SECRET@CLOUD_NAME
#                       Sign up free at https://cloudinary.com
#
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
GARAGEOS_SECRET_KEY=""

# Public site origin (Stripe returns, absolute links).
# Local:
APP_URL="http://localhost:3000"
# Vercel Production (set in dashboard, not only here):
# APP_URL="https://autogaragify.com"

# Live SMS (Twilio). Trial accounts can only text verified numbers.
# Prefer Ops → Support & compliance paste on production, or set env below.
# 1. Sign up at https://www.twilio.com/try-twilio (complete MFA if asked)
# 2. Console → Account SID + Auth Token
# 3. Phone Numbers → Buy/Get a number (E.164, e.g. +15551234567)
# 4. Trial: Phone Numbers → Verified Caller IDs → add your phone for tests
TWILIO_ACCOUNT_SID="ACxxxxxxxx"
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER="+15551234567"
TWILIO_API_KEY=""
TWILIO_API_KEY_SECRET=""

# Telnyx AI voice (inbound + outbound). Portal: https://portal.telnyx.com/
TELNYX_API_KEY=""                 # Mission Control → API Keys
TELNYX_CONNECTION_ID=""           # Voice → Call Control / AI connection id
TELNYX_FROM_NUMBER=""             # E.164 DID used for outbound + inbound demo line
TELNYX_PUBLIC_KEY=""              # Account public key — webhook Ed25519 verify (required)
TELNYX_ASSISTANT_ID=""            # From: npx tsx scripts/register-assistant.ts
SALES_TRANSFER_NUMBER=""          # Human warm-transfer destination (E.164)
DIALER_ENABLED="false"            # Master outbound switch — keep false until go-live checklist
DIALER_MAX_CONCURRENT="5"         # Max simultaneous outbound AI calls
DIALER_DAILY_CAP="20"             # Max outbound dials per shop per day
DIALER_DRY_RUN="false"            # true = log would-dial + contact_logs dry_run, no Telnyx
US_STATE_BLOCKLIST=""             # Comma-separated US codes to skip (e.g. CA,FL)
CRON_SECRET=""                    # Bearer secret for /api/dialer/tick
LEADS_IMPORT_SHOP_ID=""           # Default shop id for cron + inbound DID mapping
SLACK_WEBHOOK_URL=""              # Optional Slack incoming webhook for handoffs
AI_PROMPT_VERSION="v5"            # Active prompts/agent.<version>.md
# Optional test-only webhook signature bypass (never set in production):
# TELNYX_WEBHOOK_TEST_SECRET=""
# Legacy alias still accepted for from-number:
# TELNYX_PHONE_NUMBER="+15551234567"

# Transactional email — SendGrid preferred when SENDGRID_API_KEY is set;
# otherwise Resend; otherwise SMTP (nodemailer).
# Platform auth (signup verify / 2FA) uses these Vercel/env values.
# Customer invoice/campaign email can use Ops-pasted shop credentials instead.
FROM_NAME=""
FROM_EMAIL=""
EMAIL_FROM="AutoGaragify <onboarding@resend.dev>"
SENDGRID_API_KEY=""
RESEND_API_KEY=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# Optional: Mongo URI for sibling Voltic services (AutoGaragify still uses Postgres).
# MONGODB_URI=""

# Card payments (Stripe Checkout). Prefer test keys first (sk_test_…).
# 1. Sign up at https://dashboard.stripe.com/register
# 2. Developers → API keys → Secret key
# 3. Set APP_URL to https://autogaragify.com in Vercel Production
# 4. Billing → invoice → Pay with card
# Test card: 4242 4242 4242 4242 · any future expiry · any CVC
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_CLIENT_ID=""

# Customer financing (Wisetack or Affirm). Optional.
# FINANCING_MODE=sandbox (default) shows demo monthly options without partner keys.
# Set FINANCING_MODE=off to hide financing until you have a provider.
FINANCING_MODE="sandbox"
WISETACK_PARTNER_ID=""
AFFIRM_PUBLIC_API_KEY=""
AFFIRM_SECRET_API_KEY=""
FINANCING_WEBHOOK_URL=""

# Stripe Terminal (card-present / counter). Optional.
# Test keys: Billing → Pay at counter uses simulated collect + ledger write-back.
# Live: add a Terminal location id after creating a reader in Stripe Dashboard.
STRIPE_TERMINAL_LOCATION_ID=""

# Parts supplier network (PartsTech-style). Default sandbox catalog — no partner key required.
# PARTSTECH_MODE=sandbox | live | off
PARTSTECH_MODE="sandbox"
PARTSTECH_API_KEY=""

# Accounting sync (QuickBooks / Xero / webhook). Optional.
# Prefer Ops → Accounting & CRM for Zapier Catch Hook on production.
# ACCOUNTING_PROVIDER="webhook" | "quickbooks" | "xero" | "sandbox"
ACCOUNTING_PROVIDER=""
ACCOUNTING_WEBHOOK_URL=""
ACCOUNTING_WEBHOOK_SECRET=""
# When true (default), webhook payloads also include invoice/payment entity arrays.
ACCOUNTING_INCLUDE_ENTITIES="true"
#
QUICKBOOKS_ACCESS_TOKEN=""
QUICKBOOKS_REALM_ID=""
QUICKBOOKS_AR_ACCOUNT_ID=""
QUICKBOOKS_INCOME_ACCOUNT_ID=""
QUICKBOOKS_DEPOSIT_ACCOUNT_ID=""
QUICKBOOKS_API_BASE="https://sandbox-quickbooks.api.intuit.com"
QUICKBOOKS_MINOR_VERSION="65"
#
XERO_ACCESS_TOKEN=""
XERO_TENANT_ID=""
XERO_AR_ACCOUNT_CODE="610"
XERO_INCOME_ACCOUNT_CODE="200"
XERO_DEPOSIT_ACCOUNT_CODE="090"

# Production operations
# Lead CSV import (CLI / headless)
# LEADS_IMPORT_SECRET=""
# LEADS_IMPORT_SHOP_ID=""
# python scripts/import_leads.py scripts/auto_repair_leads.csv

APP_VERSION="1.0.0"
DEPLOYMENT_REGION="vercel"
SUPPORT_EMAIL=""
SENTRY_DSN=""

# Inspection media uploads (Cloudinary).
CLOUDINARY_URL=""

# Labor guides: reference pack and CSV import work without keys.
# Licensed MOTOR labor data:
# 1. https://www.motor.com/developer-hub/
# 2. Sandbox keys below work for testing
# 3. Production: partner contract + your keys
MOTOR_API_PUBLIC_KEY="NQfWGktRwx"
MOTOR_API_PRIVATE_KEY="h0dpvDe-oPtISJHQ5d7iv_0gZ"
