# Required credentials for AutoGragify features
#
# REQUIRED (core app):
# DATABASE_URL          PostgreSQL connection string
# GARAGEOS_SECRET_KEY  32-byte base64 key that encrypts shop-pasted provider secrets
#                       (Resend/Twilio/Zapier) at rest. Generate with:
#                       node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#                       If unset, secrets are stored plaintext (dev only). Never rotate
#                       after production use without re-saving each shop's credentials.
#
# OPTIONAL (inspection photo/video uploads only):
# CLOUDINARY_URL        cloudinary://API_KEY:API_SECRET@CLOUD_NAME
#                       Sign up free at https://cloudinary.com
#
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Live SMS (Twilio). Trial accounts can only text verified numbers.
# 1. Sign up at https://www.twilio.com/try-twilio (complete MFA if asked)
# 2. Console → Account SID + Auth Token
# 3. Phone Numbers → Buy/Get a number (E.164, e.g. +15551234567)
# 4. Trial: Phone Numbers → Verified Caller IDs → add your phone for tests
# 5. Paste below, restart AutoGragify → Operations → Send test SMS
# If Twilio signup is blocked, MessageBird (or similar) can be wired later the same way.
TWILIO_ACCOUNT_SID="ACxxxxxxxx"
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER="+15551234567"
# Optional legacy fields (not required for AutoGragify SMS):
TWILIO_API_KEY=""
TWILIO_API_KEY_SECRET=""

# Transactional email (Resend). Required for live invoice + low-stock emails.
# 1. Create a free account at https://resend.com
# 2. API Keys → Create API Key → paste below
# 3. For testing without a domain, use: EMAIL_FROM="AutoGragify <onboarding@resend.dev>"
#    (Resend only delivers to your signup email until a domain is verified)
# 4. For production: Resend → Domains → Add domain → add DNS (SPF/DKIM) at your DNS host
#    (Cloudflare/Namecheap/etc — not always the same account as Cloudflare “Domains”)
# 5. When Verified, set EMAIL_FROM="Your Shop <service@your-domain.com>" and restart
RESEND_API_KEY=""
EMAIL_FROM="AutoGragify <onboarding@resend.dev>"

# App origin used for Stripe Checkout return URLs (local default is fine).
APP_URL="http://localhost:3000"

# Card payments (Stripe Checkout). Prefer test keys first (sk_test_…).
# 1. Sign up at https://dashboard.stripe.com/register
# 2. Developers → API keys → Secret key
# 3. Paste STRIPE_SECRET_KEY below, restart AutoGragify
# 4. Billing → invoice → Pay with card
# Test card: 4242 4242 4242 4242 · any future expiry · any CVC
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_CLIENT_ID=""

# Accounting sync (QuickBooks / Xero / webhook). Optional.
# Without credentials, Reports → Sync accounting runs in sandbox and writes sync history.
# Prefer one mode:
#   ACCOUNTING_PROVIDER="webhook" | "quickbooks" | "xero" | "sandbox"
#
# Webhook (Zapier/Make/custom bookkeeper endpoint) — easiest live path:
# 1. Zapier Zap → Trigger: Webhooks by Zapier → Catch Hook
# 2. Copy Custom webhook URL (must look like hooks.zapier.com/hooks/catch/…/…/)
# 3. Paste below, restart AutoGragify, Sync accounting, then Publish the Zap
# If Zapier returns 404 "please unsubscribe me!", the hook URL is dead — create a new Catch Hook.
ACCOUNTING_PROVIDER=""
ACCOUNTING_WEBHOOK_URL=""
ACCOUNTING_WEBHOOK_SECRET=""
#
# QuickBooks Online (OAuth access token + realm + chart-of-accounts IDs):
QUICKBOOKS_ACCESS_TOKEN=""
QUICKBOOKS_REALM_ID=""
QUICKBOOKS_AR_ACCOUNT_ID=""
QUICKBOOKS_INCOME_ACCOUNT_ID=""
QUICKBOOKS_DEPOSIT_ACCOUNT_ID=""
QUICKBOOKS_API_BASE="https://sandbox-quickbooks.api.intuit.com"
QUICKBOOKS_MINOR_VERSION="65"
#
# Xero (OAuth access token + tenant + optional account codes):
XERO_ACCESS_TOKEN=""
XERO_TENANT_ID=""
XERO_AR_ACCOUNT_CODE="610"
XERO_INCOME_ACCOUNT_CODE="200"
XERO_DEPOSIT_ACCOUNT_CODE="090"

# Production operations
APP_VERSION="1.0.0"
DEPLOYMENT_REGION="local"
SUPPORT_EMAIL=""
SENTRY_DSN=""

# Inspection media uploads (Cloudinary). Required for photo/video attachments.
CLOUDINARY_URL=""

# Labor guides: no API key required. Use Labor & vehicle data →
# "Load reference pack" or "Import CSV" (template at GET /api/labor/import).
# Licensed MOTOR / AllData feeds need a separate vendor contract if you add them later.
